<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <Import Project="..\build\Common.props" />
  <PropertyGroup>
    <ProjectGuid>{17D3DBB9-9A31-4D6C-A6CF-C3003DBD7BBE}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LemonPaperplane</RootNamespace>
    <AssemblyName>LemonPaperplane</AssemblyName>
    <StartupObject>LemonPaperplane.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="UIAutomationProvider" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VendorDir)Newtonsoft.Json\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(VendorDir)WebView2\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf">
      <HintPath>$(VendorDir)WebView2\Microsoft.Web.WebView2.Wpf.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <Compile Include="..\build\Polyfills.cs">
      <Link>Polyfills.cs</Link>
    </Compile>
    <None Include="app.manifest" />
    <None Include="App.config" />
    <!-- 控件模板（运行时用 XamlReader 读取，不走 XAML 编译） -->
    <EmbeddedResource Include="Design\Templates\*.xaml">
      <LogicalName>templates/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- WebView2 的加载器（按进程架构从 runtimes\win-<arch>\native 加载） -->
    <None Include="$(VendorDir)WebView2\runtimes\**\*.dll">
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PaperplaneKit\PaperplaneKit.csproj">
      <Project>{F6F7B759-D799-4A1A-B883-7B750E2A2EB1}</Project>
      <Name>PaperplaneKit</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
